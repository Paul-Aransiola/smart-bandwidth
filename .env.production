# Production Environment Configuration
# IMPORTANT: Copy this to .env and fill in your values

# Environment
ENV=production

# Security (CRITICAL - MUST BE CHANGED!)
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING

# Database Configuration
# For production, use PostgreSQL or MySQL
# PostgreSQL (recommended):
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/bandwidth_monitor
# MySQL alternative:
# DATABASE_URL=mysql+aiomysql://username:password@localhost:3306/bandwidth_monitor

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_TITLE=Smart Bandwidth Monitor API
API_VERSION=0.2.0
API_PREFIX=/api/v1

# Redis Configuration (Required for production)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# CORS Configuration
# Add your frontend domain(s)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","PATCH"]
CORS_ALLOW_HEADERS=["*"]

# Security Headers
ENABLE_SECURITY_HEADERS=true

# Logging
LOG_LEVEL=WARNING
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Network Monitoring
NETWORK_INTERFACE=eth0
ENABLE_MONITORING=true
MONITORING_INTERVAL=30
MONITOR_INTERVAL=5
PACKET_CAPTURE_TIMEOUT=10
CAPTURE_FILTER=

# Bandwidth Control
MAX_BANDWIDTH_MBPS=1000
DEFAULT_THROTTLE_MBPS=10
ENABLE_BLOCKING=true
ENABLE_THROTTLING=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
ENABLE_RATE_LIMITING=true

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Webhook Notifications (Optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Alert Configuration
ALERT_CHECK_INTERVAL=60
ALERT_BATCH_SIZE=100
ENABLE_ALERTS=true

# Cleanup Configuration
CLEANUP_INTERVAL_HOURS=24
RETENTION_DAYS=30
