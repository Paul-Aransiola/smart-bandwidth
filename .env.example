# =============================================================================
# Smart Bandwidth Monitor - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# 
# For production deployment:
# 1. Generate a new SECRET_KEY: openssl rand -hex 32
# 2. Set ENV=production
# 3. Configure your database connection
# 4. Enable Redis for caching and rate limiting
# 5. Configure notification channels (email, Slack, Discord)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENV=development

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_TITLE=Smart Bandwidth Monitor API
API_VERSION=0.2.0
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./bandwidth_monitor.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bandwidth_monitor

# MySQL/MariaDB
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/bandwidth_monitor

# Connection Pool Settings (for non-SQLite databases)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# CRITICAL: Generate a secure secret key for production!
# Command: openssl rand -hex 32
SECRET_KEY=change-this-secret-key-in-production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security Headers
ENABLE_SECURITY_HEADERS=true

# -----------------------------------------------------------------------------
# Redis Configuration (Caching & Rate Limiting)
# -----------------------------------------------------------------------------
# Enable Redis for better performance and rate limiting
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Network Monitoring
# -----------------------------------------------------------------------------
# Network interface to monitor (e.g., eth0, wlan0, en0)
NETWORK_INTERFACE=eth0

# Enable background monitoring
ENABLE_MONITORING=false

# Monitoring intervals (seconds)
MONITORING_INTERVAL=30
MONITOR_INTERVAL=5
PACKET_CAPTURE_TIMEOUT=10

# BPF filter for packet capture (optional)
CAPTURE_FILTER=

# -----------------------------------------------------------------------------
# Bandwidth Control
# -----------------------------------------------------------------------------
MAX_BANDWIDTH_MBPS=100
DEFAULT_THROTTLE_MBPS=10
ENABLE_BLOCKING=true
ENABLE_THROTTLING=true

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# For production, specify exact origins instead of using wildcards
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# -----------------------------------------------------------------------------
# Email Notifications (SMTP)
# -----------------------------------------------------------------------------
# SMTP server configuration for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Slack Integration
# -----------------------------------------------------------------------------
# Create an Incoming Webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=

# -----------------------------------------------------------------------------
# Discord Integration
# -----------------------------------------------------------------------------
# Create a webhook in your Discord server settings
DISCORD_WEBHOOK_URL=

# =============================================================================
# Production Deployment Checklist
# =============================================================================
# [ ] Change SECRET_KEY to a secure random value
# [ ] Set ENV=production
# [ ] Use PostgreSQL or MySQL instead of SQLite
# [ ] Enable Redis (REDIS_ENABLED=true)
# [ ] Configure proper CORS_ORIGINS (no wildcards)
# [ ] Set appropriate LOG_LEVEL (WARNING or ERROR)
# [ ] Configure SSL/TLS for database connections
# [ ] Set up monitoring with ENABLE_MONITORING=true
# [ ] Configure notification channels (SMTP, Slack, Discord)
# [ ] Review and adjust rate limiting settings
# [ ] Set up proper log rotation
# [ ] Configure firewall rules
# [ ] Enable database backups
# =============================================================================
